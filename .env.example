# --- Database ---
# Local dev: point at your local PostgreSQL instance.
# Production (Neon): use the "pooled" connection string from your Neon dashboard.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gvportfolio?schema=public"

# --- NextAuth ---
# Generate a strong random secret for production, e.g.: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Local dev: http://localhost:3000 (or whatever port you run on)
# Production: your live domain, e.g. https://ganeshvarma.in
NEXTAUTH_URL="http://localhost:3000"

# --- Admin account (used only by the seed script) ---
# These credentials are read once by `npm run db:seed` to create the single admin user.
# After the admin user exists in the database, changing these values does nothing —
# use the in-app "Change password" screen (/admin/account) instead.
ADMIN_EMAIL="admin@ganeshvarma.in"
ADMIN_PASSWORD="12345678"
